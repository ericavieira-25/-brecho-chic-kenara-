{
  "version": 2,
  "routes": [
    { "src": "/sw.js", "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" }, "continue": true },
    { "src": "/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json", "Cache-Control": "no-cache" }, "continue": true },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
